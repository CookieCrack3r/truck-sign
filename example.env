# Truck Signs API - configuration template.
#
# Copy this file to .env and fill in the values:
#     cp example.env .env
#
# .env is listed in .gitignore and must never be committed. All values below
# are placeholders - replace them, do not use them as they are.

# --- Application -----------------------------------------------------------
# MODE=prod switches Django to PostgreSQL; anything else falls back to SQLite.
MODE=prod
DEBUG_ENABLED=False
LOG_LEVEL=ERROR

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<your-django-secret-key>

# Comma separated, no spaces. Add the public address of your VM.
ALLOWED_HOSTS=localhost,127.0.0.1,<your-server-address>
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# DB_HOST defaults to the compose service name "db", DB_PORT to 5432. Override
# them only when pointing the backend at a database outside this stack.
DB_NAME=trucksigns_db
DB_USER=trucksigns_user
DB_PASSWORD=<your-database-password>
DB_HOST=db
DB_PORT=5432

# --- Published port and image ----------------------------------------------
# The port the API answers on, on the host.
BACKEND_PORT=8020
# Image tag to deploy. Pinned to a release tag by default; use `main` for the
# latest build of the default branch.
IMAGE_TAG=v1.0.1
GUNICORN_WORKERS=4

# --- Admin account ---------------------------------------------------------
# Optional. When username and password are set, the entrypoint creates this
# superuser on first start and skips the step on every later start.
DJANGO_SUPERUSER_USERNAME=<your-admin-username>
DJANGO_SUPERUSER_EMAIL=<your-admin-email>
DJANGO_SUPERUSER_PASSWORD=<your-admin-password>

# --- Optional: Cloudinary media storage -------------------------------------
# Leave empty to store uploaded media in the local media volume instead.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
